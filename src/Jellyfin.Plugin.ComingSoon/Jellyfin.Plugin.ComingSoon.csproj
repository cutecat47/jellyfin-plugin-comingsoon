<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.ComingSoon</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ComingSoon</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML doc comments shouldn't fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Only our own dll goes into the plugin folder; Jellyfin supplies its own assemblies. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the admin API controller; provided by the Jellyfin host at runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Same version as Jellyfin 12.1's Directory.Packages.props; the server's loaded copy is used at runtime. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Resources\stub.mp4" LogicalName="Jellyfin.Plugin.ComingSoon.Resources.stub.mp4" />
    <EmbeddedResource Include="Resources\Fonts\Lato-Bold.ttf" LogicalName="Jellyfin.Plugin.ComingSoon.Resources.Lato-Bold.ttf" />
    <EmbeddedResource Include="Resources\Fonts\Lato-Regular.ttf" LogicalName="Jellyfin.Plugin.ComingSoon.Resources.Lato-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\meta.json" CopyToOutputDirectory="PreserveNewest" Link="meta.json" />
  </ItemGroup>

  <!-- Release builds also produce artifacts/ComingSoon_<version>/, ready to copy into Jellyfin's plugins folder. -->
  <Target Name="PackagePluginFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginDeployDir>$(MSBuildThisFileDirectory)..\..\artifacts\ComingSoon_$(Version)\</PluginDeployDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)meta.json" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="[ComingSoon] Plugin folder ready: $([System.IO.Path]::GetFullPath('$(PluginDeployDir)'))" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.ComingSoon.Tests" />
  </ItemGroup>

</Project>
