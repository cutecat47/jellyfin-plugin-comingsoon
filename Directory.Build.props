<Project>
  <!-- Shared settings for the plugin and its test project. -->
  <PropertyGroup>
    <!-- Jellyfin 12.1 ships Jellyfin.Controller/Model 12.1.0 targeting net10.0 only. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JellyfinVersion>12.1.0</JellyfinVersion>
    <Version>0.4.7.0</Version>
  </PropertyGroup>
</Project>
